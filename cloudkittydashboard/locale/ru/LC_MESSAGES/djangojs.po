msgid "Calculating the price..."
msgstr "Расчет стоимости..."

msgid "Estimated price for the instance(s) you are launching."
msgstr "Расчетная стоимость создаваемых инстансов."

msgid "Instance"
msgstr "Инстанс"

msgid "Item"
msgstr "Элемент"

msgid "Price"
msgstr "Стоимость"

