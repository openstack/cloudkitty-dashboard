msgstr "Итоговая стоимость не включает элементы, стоимость которых недоступна."

msgid "Total"
msgstr "Всего"

msgid "Unable to retrieve the price."
msgstr "Не удалось получить стоимость."

msgid "Volume"
msgstr "Диск"

msgid "unavailable"
msgstr "недоступно"
